# ==============================================================================
# miStudio Docker Environment Configuration
# ==============================================================================
# Copy this file to .env and customize for your environment
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=mistudio

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=change-me-in-production-use-a-long-random-string

# HuggingFace Configuration (optional)
HF_TOKEN=

# OpenAI Configuration (optional - for auto-labeling)
OPENAI_API_KEY=

# Judge-prompt seed files (optional). Starter judge prompts ship in the image;
# point this at a folder of mistudio.judge-prompt/v1 files (the format Export
# writes) to add more at startup without a code change. Empty = built-in only.
# JUDGE_PROMPT_SEED_DIR=/data/judge-prompt-seeds

# ============================================
# MCP Server (Feature 010 — agentic access)
# Enable with: docker compose --profile mcp up -d
# ============================================
# REQUIRED to run the MCP server. Port 8765 is LAN-reachable by default —
# generate a strong token (e.g. `openssl rand -hex 32`) and firewall the
# port if agents only run on this host.
MCP_AUTH_TOKEN=
# Tool categories to expose (admin = destructive deletes, off by default):
# read, groups, steering, labeling, experiments, jobs, admin
MCP_TOOL_CATEGORIES=read,groups,steering,labeling,experiments,jobs
# Require operator approval (Steering panel) for agent steering calls
MCP_STEERING_APPROVAL=false
MCP_STEERING_MAX_CONCURRENT=2
MCP_STEERING_MAX_NEW_TOKENS=512
