# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mistudio
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/mistudio

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Data Storage Paths
DATA_DIR=/data
HF_HOME=/data/huggingface_cache

# API port (read by docker-entrypoint.sh, not by the application settings)
API_PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://dev-mistudio.hitsai.local,http://localhost:3000,http://localhost

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# HuggingFace Configuration
HF_TOKEN=
HF_CACHE_DIR=/data/huggingface_cache

# WebSocket Configuration
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# SAE training buffer (Feature 036). Also changeable while miStudio runs:
# Settings -> Environment.
# ACTIVATION_READ_THREADS=12
# ACTIVATION_PREFETCH=true

# Development/Production
ENVIRONMENT=development

# ============================================================================
# Neuronpedia Local Instance Configuration (Optional)
# ============================================================================
# Enable "Push to Neuronpedia" feature for direct database push to local instance
# Database connection for local Neuronpedia instance
# Native backend connects via localhost:5433 (mapped from neuronpedia-postgres container)
NEURONPEDIA_LOCAL_DB_URL=postgresql://neuronpedia:neuronpedia_local_dev@localhost:5433/neuronpedia
# Public URL for Neuronpedia webapp
NEURONPEDIA_LOCAL_URL=http://dev-neuronpedia.hitsai.local
# User ID for creator when pushing data (optional)
NEURONPEDIA_LOCAL_ADMIN_USER_ID=mistudio-admin
