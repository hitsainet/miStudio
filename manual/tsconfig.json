{
  // This file is not used in compilation (`npm run typecheck` only). It is here for the editor.
  //
  // NOT `"extends": "@docusaurus/tsconfig"` (2026-10-21). That preset (3.10.2, the latest) sets
  // `baseUrl`, which TypeScript 7 rejects even when inherited (TS5102: "Option 'baseUrl' has been
  // removed") and TypeScript 6 deprecates (TS5101). Its other options are copied here unchanged;
  // `paths` now resolves relative to this file, as `baseUrl: "."` made it do before. Go back to
  // extending the preset once a Docusaurus release drops `baseUrl` from it.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
